# Gemini AI API Key (required for dynamic health insights generation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Other API Keys (optional)
VITE_YOUTUBE_API_KEY=your_youtube_api_key
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_MEDICAL_BOT_API_KEY=your_medical_bot_api_key

# Backend URL for production (only set if using separate backend server)
# Leave empty for local dev — frontend makes direct Gemini API calls.
VITE_API_BASE_URL=
